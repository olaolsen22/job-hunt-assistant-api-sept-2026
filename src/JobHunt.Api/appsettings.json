{
  "ConnectionStrings": {
    "Default": "Data Source=jobhunt.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ListingImports": {
    "Folder": "listing-imports",
    "PollSeconds": 60
  },
  "Seed": {
    "GuestEmail": "guest@jobhunt.local"
  },
  "Llm": {
    "Providers": {
      "Anthropic": [
        { "Id": "claude-haiku-4-5-20251001", "Label": "Claude Haiku 4.5", "MaxOutputTokens": 64000, "ContextWindowTokens": 200000 }
      ],
      "OpenAI": [
        { "Id": "gpt-4.1-mini", "Label": "GPT-4.1 mini", "MaxOutputTokens": 32768, "ContextWindowTokens": 1047576 }
      ],
      "Mistral": [
        { "Id": "mistral-large-2512", "Label": "Mistral Large 3", "MaxOutputTokens": 32768, "ContextWindowTokens": 256000 }
      ]
    },
    "Gemini": {
      "DefaultModel": "gemini-3.1-flash-lite",
      "Models": [
        { "Id": "gemini-3.1-flash-lite", "Label": "Gemini 3.1 Flash-Lite", "RequestsPerDay": 500 }
      ]
    }
  }
}
