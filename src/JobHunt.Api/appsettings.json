{
  "ConnectionStrings": {
    "Default": "Data Source=jobhunt.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ListingImports": {
    "Folder": "listing-imports",
    "PollSeconds": 60
  },
  "Seed": {
    "GuestEmail": "guest@jobhunt.local"
  },
  "Llm": {
    "Providers": {
      "OpenAI": [
        { "Id": "gpt-6-luna", "Label": "GPT-6 Luna", "MaxOutputTokens": 128000, "ContextWindowTokens": 1050000 },
        { "Id": "gpt-6.1-terra", "Label": "GPT-6.1 Terra", "MaxOutputTokens": 128000, "ContextWindowTokens": 1050000 },
        { "Id": "gpt-6.2-sol", "Label": "GPT-6.2 Sol", "MaxOutputTokens": 128000, "ContextWindowTokens": 1050000 },
        { "Id": "gpt-6.2-astra", "Label": "GPT-6.2 Astra", "MaxOutputTokens": 128000, "ContextWindowTokens": 1050000 }
      ],
      "Mistral": [
        { "Id": "mistral-large-2512", "Label": "Mistral Large 3", "MaxOutputTokens": 32768, "ContextWindowTokens": 256000 }
      ]
    },
    "Gemini": {
      "DefaultModel": "gemini-3.1-flash-lite",
      "Models": [
        { "Id": "gemini-3.1-flash-lite", "Label": "Gemini 3.1 Flash-Lite", "RequestsPerDay": 500 }
      ]
    }
  }
}
